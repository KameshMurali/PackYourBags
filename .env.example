ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional overrides:
# ANTHROPIC_MODEL=claude-sonnet-4-6
# USAGE_COOKIE_SECRET=a_long_random_string_for_signing_quota_cookies

# ---------------------------------------------------------------------------
# Authentication (Auth.js / NextAuth v5 + Google)
# ---------------------------------------------------------------------------
# Session encryption secret. Generate with: npx auth secret
# Required in production; without it sign-in fails at runtime (build still works).
# It also signs the MCP connector's OAuth codes and tokens (set MCP_OAUTH_SECRET to
# use a separate key). Rotating it signs everyone out and disconnects assistants.
AUTH_SECRET=generate_with_npx_auth_secret

# Google OAuth client credentials. Sign-in is only enabled when BOTH are set.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with these Authorized redirect URIs:
#   https://packyourbags.tonewbeginning.com/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret

# Comma-separated admin emails. Unset defaults to kameshwar.murali@gmail.com.
# ADMIN_EMAILS=kameshwar.murali@gmail.com,another-admin@example.com

# Optional Postgres database (Drizzle ORM). When unset, the app runs JWT-only:
# login works, nothing is persisted, and the admin page cannot list users.
# When set, run `npm run db:push` once to create the tables.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Durable storage for assistant (MCP) sync — recommended in production.
# Without these, the MCP store is in-memory and resets on serverless cold starts.
# (Vercel's Marketplace "Upstash for Redis" integration sets KV_REST_API_URL and
# KV_REST_API_TOKEN instead; those names work too.)
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
