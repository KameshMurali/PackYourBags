ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional overrides:
# ANTHROPIC_MODEL=claude-sonnet-4-6
# USAGE_COOKIE_SECRET=a_long_random_string_for_signing_quota_cookies

# Durable storage for assistant (MCP) sync — recommended in production.
# Without these, the MCP store is in-memory and resets on serverless cold starts.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
